# Geoffery's Son Discord Bot — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# On the production LXC, the bot's systemd unit reads from
# /etc/geofferys-son/env instead of a .env file. Update both.

# ------------------------------------------------------------------
# Required
# ------------------------------------------------------------------

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Discord guild ID the bot operates in (used as a default)
DISCORD_GUILD=

# Tenor API key for /anime, /punch, etc. (https://tenor.com/gifapi)
TENOR_API_KEY=

# The Cat API key for /cat (https://thecatapi.com/)
THE_CAT_API=

# ------------------------------------------------------------------
# Optional — features degrade gracefully if missing
# ------------------------------------------------------------------

# RapidAPI key for /id (random-user.p.rapidapi.com). If missing, /id returns
# "API not configured". Get a key at https://rapidapi.com/.
X_RAPIDAPI_KEY=

# RapidAPI key for /joke primary source (joke3.p.rapidapi.com). If missing,
# /joke falls back to the free jokeapi (sv443.net) automatically.
JOKE3_RAPIDAPI_KEY=
